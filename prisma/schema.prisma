generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountMode {
  DEMO
  REAL
}

enum UserStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum FundingStatus {
  PENDING
  PENDING_REVIEW
  PROCESSING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum FundingType {
  DEPOSIT
  WITHDRAWAL
}

enum EntryType {
  DEBIT
  CREDIT
}

enum SupportStatus {
  AWAITING_ADMIN
  AWAITING_USER
  RESOLVED
}

enum SupportAuthor {
  USER
  ADMIN
  NOVA
}

enum SupportCategory {
  GENERAL
  FUNDING
  WITHDRAWAL
  ACCOUNT
  SECURITY
  COMPLAINT
}

enum NotificationType {
  ACCOUNT
  SECURITY
  KYC
  DEPOSIT
  WITHDRAWAL
  TRADE
  MARKET
  SUPPORT
  SYSTEM
}

enum VerificationChannel {
  EMAIL
  SMS
}

enum ClientStoryStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  PUBLISHED
  REJECTED
  ARCHIVED
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  phone String?
  phoneVerified Boolean @default(false)
  phoneVerifiedAt DateTime?
  activeSessionId String? @unique
  activeSessionUpdatedAt DateTime?
  country String?
  role Role @default(USER)
  accountMode AccountMode @default(DEMO)
  status UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean @default(false)
  termsAcceptedAt DateTime?
  kycStatus KycStatus @default(PENDING)
  verifiedAt DateTime?
  verifiedChannel VerificationChannel?
  requiresRegistrationVerification Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  positions Position[]
  funding FundingRequest[]
  ledgerAccounts LedgerAccount[]
  auditLogs AuditLog[]
  kyc KycProfile?
  supportConversations SupportConversation[]
  supportMessages SupportMessage[]
  notifications Notification[]
  verificationCode VerificationCode?
  passwordResetTokens PasswordResetToken[]
  clientStories ClientStory[]
  avatarKey String?
}

model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  type NotificationType
  title String
  message String
  isRead Boolean @default(false)
  relatedEntity String?
  relatedId String?
  actionUrl String?
  dedupeKey String @unique
  createdAt DateTime @default(now())
  @@index([userId,isRead,createdAt])
  @@index([userId,createdAt])
}

model VerificationCode {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  codeHash String
  channel VerificationChannel
  expiresAt DateTime
  resendAfter DateTime
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
  @@index([expiresAt])
}
model KycProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  legalName String?
  dob DateTime?
  address String?
  idType String?
  idNumber String?
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewNote String?
}
model Instrument {
  id String @id @default(cuid())
  symbol String @unique
  name String
  baseAsset String
  quoteAsset String
  price Decimal @db.Decimal(30,10)
  tickSize Decimal @default(0.01) @db.Decimal(30,10)
  leverage Decimal @default(1) @db.Decimal(10,2)
  makerFee Decimal @default(0.001) @db.Decimal(10,6)
  takerFee Decimal @default(0.0015) @db.Decimal(10,6)
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  positions Position[]
  candles Candle[]
}
model Candle {
  id String @id @default(cuid())
  instrumentId String
  instrument Instrument @relation(fields:[instrumentId],references:[id],onDelete:Cascade)
  ts DateTime
  open Decimal @db.Decimal(30,10)
  high Decimal @db.Decimal(30,10)
  low Decimal @db.Decimal(30,10)
  close Decimal @db.Decimal(30,10)
  volume Decimal @db.Decimal(30,10)
  @@unique([instrumentId,ts])
  @@index([instrumentId,ts])
}
model Order {
  id String @id @default(cuid())
  userId String
  instrumentId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  instrument Instrument @relation(fields:[instrumentId],references:[id])
  side OrderSide
  type OrderType
  status OrderStatus @default(OPEN)
  accountMode AccountMode @default(DEMO)
  quantity Decimal @db.Decimal(30,10)
  filledQuantity Decimal @default(0) @db.Decimal(30,10)
  price Decimal? @db.Decimal(30,10)
  stopPrice Decimal? @db.Decimal(30,10)
  averageFillPrice Decimal? @db.Decimal(30,10)
  fee Decimal @default(0) @db.Decimal(30,10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  executions Execution[]
  @@index([userId,status])
}
model Execution {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  quantity Decimal @db.Decimal(30,10)
  price Decimal @db.Decimal(30,10)
  fee Decimal @db.Decimal(30,10)
  createdAt DateTime @default(now())
}
model Position {
  id String @id @default(cuid())
  userId String
  instrumentId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  instrument Instrument @relation(fields:[instrumentId],references:[id])
  side OrderSide
  quantity Decimal @db.Decimal(30,10)
  entryPrice Decimal @db.Decimal(30,10)
  leverage Decimal @default(1) @db.Decimal(10,2)
  realizedPnl Decimal @default(0) @db.Decimal(30,10)
  margin Decimal @default(0) @db.Decimal(30,10)
  status PositionStatus @default(OPEN)
  accountMode AccountMode @default(DEMO)
  openedAt DateTime @default(now())
  closedAt DateTime?
  @@index([userId,status])
}
model LedgerAccount {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:Cascade)
  accountMode AccountMode @default(DEMO)
  code String @unique
  name String
  currency String @default("USD")
  entries LedgerEntry[]
  createdAt DateTime @default(now())
}
model LedgerTransaction {
  id String @id @default(cuid())
  reference String @unique
  description String
  createdAt DateTime @default(now())
  entries LedgerEntry[]
}
model LedgerEntry {
  id String @id @default(cuid())
  transactionId String
  accountId String
  type EntryType
  amount Decimal @db.Decimal(30,10)
  transaction LedgerTransaction @relation(fields:[transactionId],references:[id],onDelete:Cascade)
  account LedgerAccount @relation(fields:[accountId],references:[id])
  createdAt DateTime @default(now())
  @@index([accountId,createdAt])
}
model FundingRequest {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  type FundingType
  method String
  amount Decimal @db.Decimal(30,10)
  currency String @default("USD")
  status FundingStatus @default(PENDING)
  accountMode AccountMode @default(DEMO)
  paymentMethodId String?
  paymentMethod PaymentMethod? @relation(fields:[paymentMethodId],references:[id],onDelete:SetNull)
  idempotencyKey String? @unique
  transactionReference String?
  referenceInfo String?
  destinationInfo String?
  senderInfo String?
  beneficiaryInfo String?
  network String?
  note String?
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviewedAt DateTime?
  verifiedAt DateTime?
  settlementReference String?
  settledAt DateTime?
  receiptKey String?
  supportConversations SupportConversation[]
  clientStory ClientStory?
  @@index([status,createdAt])
  @@index([userId,accountMode,createdAt])
  @@index([type,accountMode,status,createdAt])
}
model PaymentMethod {
  id String @id @default(cuid())
  name String
  enabled Boolean @default(true)
  demoOnly Boolean @default(false)
  depositEnabled Boolean @default(true)
  withdrawalEnabled Boolean @default(true)
  requiresNetwork Boolean @default(false)
  currencies String[] @default(["USD"])
  destination String?
  instructions String?
  minimumAmount Decimal @default(0) @db.Decimal(30,10)
  maximumAmount Decimal? @db.Decimal(30,10)
  processingNotes String?
  displayOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fundingRequests FundingRequest[]
  @@index([enabled,displayOrder])
}
model SupportConversation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  accountMode AccountMode @default(DEMO)
  subject String
  category SupportCategory @default(GENERAL)
  isComplaint Boolean @default(false)
  attachmentKey String?
  status SupportStatus @default(AWAITING_ADMIN)
  transactionId String?
  transaction FundingRequest? @relation(fields:[transactionId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastMessageAt DateTime @default(now())
  messages SupportMessage[]
  @@index([userId,createdAt])
  @@index([status,lastMessageAt])
}
model SupportMessage {
  id String @id @default(cuid())
  conversationId String
  conversation SupportConversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  authorType SupportAuthor
  authorId String?
  author User? @relation(fields:[authorId],references:[id],onDelete:SetNull)
  body String
  createdAt DateTime @default(now())
  @@index([conversationId,createdAt])
}
model SystemSetting {
  key String @id
  value String
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model ClientStory {
  id String @id @default(cuid())
  displayName String
  country String
  cityOrRegion String?
  quote String
  imageReference String?
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  verifiedWithdrawalId String? @unique
  withdrawal FundingRequest? @relation(fields:[verifiedWithdrawalId],references:[id],onDelete:SetNull)
  withdrawalAmount Decimal? @db.Decimal(30,10)
  currency String?
  verifiedClient Boolean @default(false)
  transactionVerified Boolean @default(false)
  consentConfirmed Boolean @default(false)
  showWithdrawalAmount Boolean @default(false)
  displayCurrency String?
  publicationStatus ClientStoryStatus @default(DRAFT)
  source String?
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([publicationStatus,createdAt])
  @@index([userId])
}
